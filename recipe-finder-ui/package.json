{
  "name": "recipe-finder-ui",
  "version": "0.1.0",
  "description": "Reusable StencilJS web components for recipe discovery and meal planning UIs.",
  "license": "MIT",
  "keywords": [
    "stencil",
    "web-components",
    "custom-elements",
    "recipes",
    "meal-planner",
    "svelte"
  ],
  "homepage": "https://github.com/Blackbaud-AryanTyagi/recipe-finder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackbaud-AryanTyagi/recipe-finder.git",
    "directory": "recipe-finder-ui"
  },
  "bugs": {
    "url": "https://github.com/Blackbaud-AryanTyagi/recipe-finder/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/recipe-finder-ui/recipe-finder-ui.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./dist/recipe-finder-ui/recipe-finder-ui.esm.js": "./dist/recipe-finder-ui/recipe-finder-ui.esm.js",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./dist/recipe-finder-ui/recipe-finder-ui.css": "./dist/recipe-finder-ui/recipe-finder-ui.css",
    "./theme.css": "./dist/recipe-finder-ui/recipe-finder-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "loader/",
    "!dist/**/*.test.*",
    "!dist/**/*.unit.*",
    "!dist/**/*.cmp.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate",
    "smoke": "node scripts/smoke-package.mjs",
    "prepublishOnly": "npm run build && npm run smoke"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  }
}
